<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>HearIt</string>
	<key>CFBundleName</key>
	<string>HearIt</string>
	<key>CFBundleExecutable</key>
	<string>HearIt</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Names the asset-catalog app icon. Normally actool injects this, but with
	     a manual Info.plist it must be declared so App Store upload accepts it. -->
	<key>CFBundleIconName</key>
	<string>$(ASSETCATALOG_COMPILER_APPICON_NAME)</string>
	<!-- Hands-free voice notes on highlights (AirPods press). -->
	<key>NSMicrophoneUsageDescription</key>
	<string>HearIt uses the microphone so you can dictate a note on a highlight, hands-free with your AirPods.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>HearIt transcribes your spoken note into text for the highlight.</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- The app uses only standard HTTPS encryption, which is exempt — declaring
	     this skips the export-compliance question on every TestFlight upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- iPad allows portrait + both landscapes so the list/reading split view can
	     show side-by-side however the device is held. UIRequiresFullScreen below
	     opts out of multitasking, so App Store validation doesn't require all four
	     orientations (no upside-down). -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<true/>

	<!-- Keep reading email aloud while the app is backgrounded or the screen is
	     locked; fetch lets iOS wake us periodically to refresh RSS feeds and post
	     new-article notifications. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
	</array>
	<!-- Identifier for the BGAppRefreshTask that refreshes feeds in the background. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.aviashkenazi.voiceinbox.feedrefresh</string>
	</array>

	<!-- Google Sign-In redirects back to the app via a reversed-client-id URL scheme.
	     Replace the placeholder below with your reversed client id once you create
	     an OAuth client in the Google Cloud console. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.1010510206522-1pc27rqvv9ip4p35t6inu6ktnl1gilav</string>
			</array>
		</dict>
		<!-- Outlook/Microsoft sign-in redirect (register the matching redirect URI
		     msauth.com.aviashkenazi.voiceinbox://auth in your Azure app). -->
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>msauth.com.aviashkenazi.voiceinbox</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
