<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Group removed for now: it requires a paid Apple Developer account to
	     register and would block signing on a personal team. The app falls back
	     to standard storage, and phone <-> watch still sync over WatchConnectivity.
	     To re-enable sharing on a paid account, add back:
	     <key>com.apple.security.application-groups</key>
	     <array><string>group.com.aviashkenazi.voiceinbox</string></array>
	     and update the group id in AppSettings.swift and HighlightStore.swift. -->
</dict>
</plist>
