<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Group: shares saved articles (from the Share Extension), highlights,
	     and settings across the app, the Share Extension, and the watch.
	     Requires a paid Apple Developer account; the id must match
	     AppGroup.identifier and be registered for your team, with the App Groups
	     capability enabled on both the app and ShareExtension targets. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.voiceinbox.shared</string>
	</array>
	<!-- iCloud / CloudKit: backs up the user's saved-link list (metadata only) to
	     their private database so it survives uninstall/reinstall. Enable the
	     iCloud capability with CloudKit and create the container below in Xcode →
	     Signing & Capabilities (and the Apple Developer portal). -->
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.aviashkenazi.voiceinbox</string>
	</array>
</dict>
</plist>
