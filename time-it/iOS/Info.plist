<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleDisplayName</key>
    <string>Time It</string>
    <key>CFBundleName</key>
    <string>TimeIt</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>
    <!-- App allows landscape so the running/session "activity" screens can
         rotate; everything else is locked to portrait at runtime via the app
         delegate (see OrientationLock). -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <!-- Keep speaking countdowns / milestones with the screen locked. -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
    <!-- Live Activity on the Lock Screen + Dynamic Island. -->
    <key>NSSupportsLiveActivities</key>
    <true/>
    <!-- Required here too (not just the watch app): App Store validation
         (ITMS-90683) demands HealthKit usage strings on the companion iOS app
         because the embedded watch app carries the HealthKit entitlement. -->
    <key>NSHealthShareUsageDescription</key>
    <string>Time It reads your heart rate on Apple Watch to display it live during workout timers and sessions.</string>
    <key>NSHealthUpdateUsageDescription</key>
    <string>Time It records your workout timers and sessions to the Fitness app on Apple Watch.</string>
    <!-- No proprietary/non-exempt encryption — skips the export-compliance
         question on every TestFlight upload so builds go live immediately. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
</dict>
</plist>
